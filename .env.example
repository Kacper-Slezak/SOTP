# .env.example
# Copy this file to .env and fill in values for your local environment.
# NOTE: The .env file should NEVER be committed to Git!

# ####################
# APPLICATION SETTINGS
# ####################

# Application environment mode (e.g. dev, prod, staging)
ENVIRONMENT=dev

# Secret key for JWT token generation. Generate a random, strong secret string.
# Example: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_me_in_production

# Algorithm used for signing JWT tokens
ALGORITHM=HS256

# Token expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ####################
# DATABASE - PostgreSQL (Inventory data)
# ####################
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sotp_user
POSTGRES_PASSWORD=very_strong_password
POSTGRES_DB=sotp_inventory_db

# Full database connection URL (used by SQLAlchemy)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://sotp_user:very_strong_password@postgres:5432/sotp_inventory_db

# ####################
# DATABASE - TimescaleDB (Time-series metrics)
# ####################
TIMESCALEDB_HOST=timescaledb
TIMESCALEDB_PORT=5433 # Use a distinct port to avoid conflicts with PostgreSQL
TIMESCALEDB_USER=sotp_ts_user
TIMESCALEDB_PASSWORD=another_very_strong_password
TIMESCALEDB_DB=sotp_metrics_db

# Full connection URL for TimescaleDB
TIMESERIES_DATABASE_URL=postgresql+asyncpg://sotp_ts_user:another_very_strong_password@timescaledb:5433/sotp_metrics_db

# ####################
# REDIS - Cache & Broker for Celery
# ####################
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD= # Uncomment if password is configured in Redis

# ####################
# VAULT - Secrets Management
# ####################
# Vault server address
VAULT_ADDR=http://vault:8200
# Token for development environment (use AppRole or equivalent in production)
VAULT_TOKEN=my_dev_vault_token

# ####################
# NOTIFICATION CHANNELS (Phase 3+)
# ####################

# SMTP server configuration for email delivery
SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Webhook URL for Slack notifications
SLACK_WEBHOOK_URL=
