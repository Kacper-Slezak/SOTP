{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Dev (Start Stack)",
      "type": "shell",
      "command": "make dev",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Docker: Down (Stop Stack)",
      "type": "shell",
      "command": "make down",
      "problemMatcher": []
    },
    {
      "label": "Docker: Logs",
      "type": "shell",
      "command": "make logs",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Test (Pytest)",
      "type": "shell",
      "command": "make test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Docker: Seed Demo Data",
      "type": "shell",
      "command": "make seed",
      "problemMatcher": []
    },
    {
      "label": "Docker: Shell Backend",
      "type": "shell",
      "command": "make shell-backend",
      "problemMatcher": []
    },
    {
      "label": "Docker: Shell Frontend",
      "type": "shell",
      "command": "make shell-frontend",
      "problemMatcher": []
    },
    {
      "label": "Docker: Clean All (Reset Volumes)",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    },
    {
      "label": "Ruff: Check and Fix",
      "type": "shell",
      "command": "ruff check --fix .",
      "problemMatcher": []
    },
    {
      "label": "Ruff: Format",
      "type": "shell",
      "command": "ruff format .",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Run Dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web_frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: Lint",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}/apps/web_frontend"
      },
      "problemMatcher": []
    }
  ]
}
